{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uiux.local/schemas/preservation-profile.schema.json",
  "title": "PreservationProfile",
  "description": "Baseline preservation requirements, protected invariants, allowed change budgets and merged granular permissions.",
  "type": "object",
  "required": [
    "schema_version",
    "protected_design",
    "allowed_changes",
    "user_permissions",
    "requested_scope",
    "confidence",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "protected_design": {
      "type": "object",
      "required": [
        "color_palette",
        "brand_identity",
        "overall_layout_identity",
        "navigation_model",
        "information_architecture"
      ],
      "properties": {
        "color_palette": {
          "type": "object",
          "required": ["policy", "baseline", "evidence"],
          "properties": {
            "policy": {"type": "string", "enum": ["locked", "unlocked"]},
            "baseline": {"type": "object"},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "brand_identity": {
          "type": "object",
          "required": ["policy", "evidence"],
          "properties": {
            "policy": {"type": "string", "enum": ["locked", "unlocked"]},
            "baseline": {"type": "object"},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "overall_layout_identity": {
          "type": "object",
          "required": ["policy", "baseline_patterns", "evidence"],
          "properties": {
            "policy": {"type": "string", "enum": ["protected", "editable"]},
            "baseline_patterns": {"type": "array", "items": {"type": "string"}},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "navigation_model": {
          "type": "object",
          "required": ["policy", "baseline", "evidence"],
          "properties": {
            "policy": {"type": "string", "enum": ["protected", "editable"]},
            "baseline": {"type": "array", "items": {"type": "string"}},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "information_architecture": {
          "type": "object",
          "required": ["policy", "routes_pages", "evidence"],
          "properties": {
            "policy": {"type": "string", "enum": ["protected", "editable"]},
            "routes_pages": {"type": "array", "items": {"type": "string"}},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "allowed_changes": {
      "type": "object",
      "required": ["L1", "L2", "L3"],
      "properties": {
        "L1": {
          "type": "object",
          "required": ["policy"],
          "properties": {
            "policy": {"type": "string", "enum": ["allowed", "restricted"]},
            "scope": {"type": "array", "items": {"type": "string"}}
          }
        },
        "L2": {
          "type": "object",
          "required": ["policy"],
          "properties": {
            "policy": {"type": "string", "enum": ["justified_only", "allowed", "denied"]},
            "required_justification": {"type": "string"}
          }
        },
        "L3": {
          "type": "object",
          "required": ["policy"],
          "properties": {
            "policy": {"type": "string", "enum": ["explicit_user_permission_only", "granted", "denied"]},
            "granted_permissions": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "user_permissions": {
      "type": "object",
      "required": [
        "allow_palette_change",
        "allow_branding_change",
        "allow_layout_change",
        "allow_navigation_change",
        "allow_architecture_change",
        "allow_rebuild",
        "explicit_l3_granted"
      ],
      "properties": {
        "allow_palette_change": {"type": "boolean"},
        "allow_branding_change": {"type": "boolean"},
        "allow_layout_change": {"type": "boolean"},
        "allow_navigation_change": {"type": "boolean"},
        "allow_architecture_change": {"type": "boolean"},
        "allow_rebuild": {"type": "boolean"},
        "explicit_l3_granted": {"type": "boolean"}
      }
    },
    "requested_scope": {
      "type": "string",
      "enum": ["global", "page", "section", "component"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
