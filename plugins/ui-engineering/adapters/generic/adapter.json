{
  "schema_version": 1,
  "id": "generic",
  "status": "skeleton",
  "description": "Host-agnostic adapter: JSON in, JSON out, over the public Core API only. Reference for every platform adapter; contains no host-specific metadata.",
  "adapter_contract_version": 1,
  "core_api": {
    "module": "uiux.api",
    "plugin_api_version": 1,
    "core_version": ">=0.1.0,<1.0.0"
  },
  "manifest_version": [1],
  "transports": ["python", "cli-json"],
  "tools": {
    "exposure": "all-public",
    "tool_map": {},
    "source": "uiux.api.list_tools",
    "invoke": "uiux.api.call_tool"
  },
  "knowledge": {
    "exposure": "progressive",
    "access": ["retrieve_knowledge"],
    "rule": "Load SKILL.md first; retrieve knowledge by id or collection through retrieve_knowledge, never whole folders."
  },
  "runtime": {
    "optional": true,
    "detection": "on-demand",
    "blocked_is_result": true,
    "installs_dependencies": false,
    "downloads_browsers": false
  },
  "errors": {
    "error_contract_version": 1,
    "source": "uiux.api.error_contract",
    "envelope": ["status", "error", "error_code", "category", "remediation", "details"]
  },
  "capability_discovery": {
    "capability_map": "uiux.api.capability_map",
    "self_test": "uiux.api.self_test"
  },
  "limitations": [
    "No host bundle export (platform adapters only).",
    "No MCP transport yet (spec section 8.0)."
  ]
}
