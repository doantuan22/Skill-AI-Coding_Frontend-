      "enterprise",
      "analytics"
    ],
    "brand_attributes": [
      "trustworthy",
      "efficient",
      "serious",
      "dense"
    ],
    "avoid_attributes": [
      "flashy",
      "playful"
    ],
    "visual_intensity": 1,
    "interaction_intensity": 3,
    "density": "high",
    "contexts": [
      "application"
    ],
    "screens": [
      "screen.dashboard",
      "screen.analytics",
      "screen.data-table"
    ],
    "content": [
      "data"
    ]
  },
  "expect": {
