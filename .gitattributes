# Line-ending policy: every text file is stored and exported with LF on every OS (reproducible checksums).
# Binary files are never transformed. Packaging additionally normalizes CRLF->LF for text files it reads
# from a working tree (plugin/packaging/artifact.py), so artifacts do not depend on local checkout settings.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pyc  binary
